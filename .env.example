# Segredo usado para assinar sessões (JWT) e criptografar a chave Gemini dos usuários.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Banco de dados (Turso / libSQL — serverless, plano gratuito).
# Em desenvolvimento, se vazio, usa um arquivo local em ./data/moneta.db
# Em produção (Vercel) é OBRIGATÓRIO.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
